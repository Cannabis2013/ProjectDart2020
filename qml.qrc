    </qresource>
    <qresource prefix="/">
        <file>qml/utils/nameUtils.js</file>
        <file>qml/main.qml</file>
        <file>qtquickcontrols2.conf</file>
        <file>qml/components/dialogs/ConfirmDialog.qml</file>
        <file>qml/components/inputControls/InputControls.qml</file>
        <file>qml/components/keyPad/keyPad.js</file>
        <file>qml/components/keyPad/KeyPad.qml</file>
        <file>qml/components/keyPad/ModPad.qml</file>
        <file>qml/components/keyPad/NumberPad.qml</file>
        <file>qml/components/keyPad/Pad.qml</file>
        <file>qml/components/messages/MessagesDisplay.qml</file>
        <file>qml/components/scoreDisplay/ScoreDisplay.qml</file>
        <file>qml/components/screens/PlayersInfoScreen.qml</file>
        <file>qml/components/screens/PlayersInfoView.qml</file>
        <file>qml/components/screens/WinnerScreen.qml</file>
        <file>qml/components/turnControls/TurnControls.qml</file>
        <file>qml/components/controls/ValueSelector.qml</file>
        <file>qml/pages/About.qml</file>
        <file>qml/pages/Setup.qml</file>
        <file>qml/pages/Start.qml</file>
        <file>qml/pages/Tournament.qml</file>
        <file>qml/templates/PageWithHeader.qml</file>
    </qresource>
    <qresource prefix="/pictures">
        <file>Ressources/Pictures/undo.png</file>
        <file>Ressources/Pictures/restart.png</file>
        <file>Ressources/Pictures/redo.png</file>
        <file>Ressources/Pictures/upArrow.png</file>
        <file>Ressources/Pictures/downArrow.png</file>
        <file>Ressources/Pictures/dartsplate.png</file>
        <file>Ressources/Pictures/trophy.png</file>
        <file>Ressources/Pictures/dart.png</file>
    </qresource>
</RCC>
